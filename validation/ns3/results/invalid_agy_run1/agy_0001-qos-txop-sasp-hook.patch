+void
+WifiMacQueue::MoveBefore(Ptr<WifiMpdu> itemToMove, Ptr<WifiMpdu> targetItem)
+{
+    NS_LOG_FUNCTION(this << itemToMove << targetItem);
+    if (!itemToMove || !targetItem || itemToMove == targetItem)
+    {
+        return;
+    }
+    auto origMove = GetOriginal(itemToMove);
+    auto origTarget = GetOriginal(targetItem);
+    if (!origMove || !origTarget || !origMove->IsQueued() || !origTarget->IsQueued())
+    {
+        return;
+    }
+    auto queueId1 = WifiMacQueueContainer::GetQueueId(origMove);
+    auto queueId2 = WifiMacQueueContainer::GetQueueId(origTarget);
+    if (queueId1 != queueId2)
+    {
+        return;
+    }
+    GetContainer().MoveBefore(queueId1, GetIt(origMove), GetIt(origTarget));
+}
